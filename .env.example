# StatusBoard Environment Variables Configuration
# Copy this file to .env.local and fill in the actual production or local values.

# Database Configuration (PostgreSQL / Supabase)
# Supabase Transaction Pooler URI (mode transaction requires prepare: false)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=

# Cron Endpoint Security
# Secret bearer / header token for authenticating scheduled cron checks (min 32 characters)
CRON_SECRET=

# Session Encryption
# Encryption secret key used by iron-session for cookie encoding (min 32 characters)
SESSION_SECRET=

# Owner Authentication
# bcrypt hash of the owner password for /admin authentication
# Generate with: node -e "require('bcryptjs').hash('your-password', 12).then(console.log)"
OWNER_PASSWORD_HASH=
